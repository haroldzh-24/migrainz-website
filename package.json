{
  "name": "studio-migrainz",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "cms:setup": "node scripts/setup-cms.mjs",
    "cms:types": "node --env-file=.env.local node_modules/payload/bin.js generate:types",
    "cms:importmap": "node --env-file=.env.local node_modules/payload/bin.js generate:importmap",
    "cms:migrate": "node --env-file=.env.local --import tsx scripts/migrate-legacy-content.ts",
    "cms:verify": "node --env-file=.env.local --import tsx scripts/verify-content-migration.ts",
    "cms:postgres:schema": "node --env-file=.env.local scripts/postgres-schema.mjs",
    "cms:verify-production": "node --env-file=.env.local scripts/verify-production-guard.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "graphql": "16.11.0",
    "next": "16.3.4",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "type": "module",
  "overrides": {
    "dompurify": "3.4.15"
  }
}
