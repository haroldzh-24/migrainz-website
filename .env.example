# DEVELOPMENT ONLY. npm run cms:setup creates private local paths and a secret.
CMS_DATABASE=sqlite
DATABASE_URL=file:///C:/Users/YOU/AppData/Local/StudioMigrainz/cms/studio.db
CMS_MEDIA_DIR=C:/Users/YOU/AppData/Local/StudioMigrainz/cms/media
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Production MUST use managed PostgreSQL and private persistent/object storage.
# CMS_DATABASE=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@MANAGED_HOST/DATABASE?sslmode=require
# Class demo on Vercel only: private, ephemeral, not shared between instances.
# CMS_MEDIA_DIR=/tmp/studio-migrainz-media
# Keep the existing production PAYLOAD_SECRET stable. Do not use this file's placeholder.

# Optional Patreon API v2. Leave unset to keep login unavailable and content locked.
# Register the exact absolute redirect URI ending in /auth/patreon/callback.
# HTTPS is required in production. Local development may use http://127.0.0.1:3000.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URI=
PATREON_CAMPAIGN_ID=
# Real Studio Migrainz Patreon page URL; no fallback/fake destination.
PATREON_URL=
# Sessions use the existing PAYLOAD_SECRET for encryption; no new session secret.
