{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm.cmd run typecheck)",
      "Bash(npm run build)",
      "Bash(npm.cmd run build)",
      "Bash(npm run test:regression)",
      "Bash(npm.cmd run test:regression)",
      "Bash(node scripts/verify-equipment-navigation.mjs *)",
      "Bash(node scripts/verify-equipment-browser.mjs *)",
      "Bash(node scripts/verify-equipment-migration.mjs *)",
      "Bash(node scripts/verify-viewer-pinch.mjs *)",
      "Bash(node scripts/verify-window-pass.mjs *)",
      "Bash(node scripts/verify-production-guard.mjs *)",
      "Bash(node scripts/verify-production-env.mjs *)",
      "Bash(node --import tsx scripts/verify-equipment.ts *)",
      "Bash(node scripts/serve-fixture.mjs *)",
      "Bash(node scripts/capture-review-screens.mjs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(npm.cmd run typecheck)",
      "PowerShell(npm.cmd run build)",
      "PowerShell(npm.cmd run test:regression)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)"
    ],
    "ask": [
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git filter-branch *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git rebase *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git stash drop *)",
      "PowerShell(git stash clear *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "PowerShell(git push *)",
      "PowerShell(git * push *)",
      "Bash(*payload* migrate*)",
      "Bash(npm* run cms:migrate*)",
      "Bash(npm* run cms:verify*)",
      "Bash(npm* run cms:postgres:schema*)",
      "PowerShell(*payload* migrate*)",
      "PowerShell(npm* run cms:migrate*)",
      "PowerShell(npm* run cms:verify*)",
      "PowerShell(npm* run cms:postgres:schema*)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(neonctl *)",
      "Bash(npx neonctl *)",
      "PowerShell(vercel *)",
      "PowerShell(npx vercel *)",
      "PowerShell(neonctl *)",
      "PowerShell(npx neonctl *)",
      "Bash(node scripts/recover-blob-media.mjs *)",
      "PowerShell(node scripts/recover-blob-media.mjs *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.vercel.local)",
      "Read(./.env.production*)",
      "Read(./.env.development*)",
      "Read(./.env.*.local)",
      "Bash(*.env.local*)",
      "Bash(*.env.vercel*)",
      "PowerShell(*.env.local*)",
      "PowerShell(*.env.vercel*)",
      "Bash(*migrate:fresh*)",
      "Bash(*migrate:reset*)",
      "Bash(*migrate:refresh*)",
      "Bash(*migrate:down*)",
      "Bash(*migrate:up*)",
      "PowerShell(*migrate:fresh*)",
      "PowerShell(*migrate:reset*)",
      "PowerShell(*migrate:refresh*)",
      "PowerShell(*migrate:down*)",
      "PowerShell(*migrate:up*)"
    ]
  }
}
